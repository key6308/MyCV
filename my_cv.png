<body data-new-gr-c-s-check-loaded="14.1153.0" data-gr-ext-installed="">

    <header>
        <div class="container">
            <h1>Key</h1>
            <p class="subtitle">Student | Technology Enthusiast | Future Professional</p>

            <nav>
                <a href="https://key6308.github.io/MyCV/#about">About Me</a>
                <a href="https://key6308.github.io/MyCV/#skills">Skills</a>
                <a href="https://key6308.github.io/MyCV/#education">Education</a>
                <a href="https://key6308.github.io/MyCV/#experience">Experience</a>
                <a href="https://key6308.github.io/MyCV/#contact">Contact</a>
            </nav>
        </div>
    </header>

    <main class="container">

        <section id="about" class="card">
            <h2>About Me</h2>

            <p>
                My name is Key. I am a motivated student who is interested in
                technology, business, and building skills that can help me grow
                professionally. I enjoy learning new things and challenging myself
                to improve.
            </p>

            <p>
                I have been developing my technology skills through coursework
                and hands-on projects. I am especially interested in web
                development, programming, and learning how technology can be
                used to solve real-world problems.
            </p>

            <p>
                My goal is to continue developing my education, technical skills,
                and professional experience. I want to build a successful career
                where I can use my knowledge, creativity, and determination to
                make a positive impact.
            </p>
        </section>

        <section id="skills" class="card">
            <h2>Skills &amp; Competencies</h2>

            <ul class="skills-list">
                <li>HTML and CSS</li>
                <li>Python Programming</li>
                <li>Web Development</li>
                <li>Git and GitHub</li>
                <li>Problem Solving</li>
                <li>Communication</li>
                <li>Teamwork</li>
                <li>Time Management</li>
                <li>Microsoft Office</li>
                <li>Learning New Technologies</li>
            </ul>
        </section>

        <section id="education" class="card">
            <h2>Education</h2>

            <div class="education-item">
                <h3>Southern Illinois University Edwardsville</h3>
                <p>
                    Graduate Studies / MBA Program
                </p>
                <p>
                    Continuing to develop knowledge in business,
                    technology, and professional management.
                </p>
            </div>

            <div class="education-item">
                <h3>Technology &amp; Web Development Coursework</h3>
                <p>
                    Completed hands-on coursework involving programming,
                    web development, GitHub, and software projects.
                </p>
            </div>
        </section>

        <section id="experience" class="card">
            <h2>Work Experience</h2>

            <div class="experience-item">
                <h3>Student &amp; Technology Projects</h3>
                <p>
                    Developed programming and web development projects as part
                    of my coursework. Worked with HTML, CSS, Python, GitHub,
                    and other technology tools.
                </p>

                <ul>
                    <li>Created and organized programming projects.</li>
                    <li>Used GitHub to manage and share project files.</li>
                    <li>Practiced problem solving and debugging.</li>
                    <li>Built websites using HTML and CSS.</li>
                    <li>Learned how to deploy static websites using GitHub Pages.</li>
                </ul>
            </div>

            <div class="experience-item">
                <h3>Professional Development</h3>
                <p>
                    Continuously working on improving my communication,
                    technology, organization, and professional skills through
                    education and hands-on learning.
                </p>
            </div>
        </section>

        <section id="contact" class="card">
            <h2>Contact Me</h2>

            <p><strong>Name:</strong> Key</p>

            <!-- Replace the information below with your real information -->
            <p>
                <strong>Email:</strong>
                <a href="mailto:YOUR-EMAIL@example.com">
                    YOUR-EMAIL@example.com
                </a>
            </p>

            <p>
                <strong>Phone:</strong>
                YOUR PHONE NUMBER
            </p>

            <p>
                <strong>GitHub:</strong>
                <a href="https://github.com/YOUR-GITHUB-USERNAME" target="_blank">
                    GitHub Profile
                </a>
            </p>

            <p>
                <strong>LinkedIn:</strong>
                <a href="https://www.linkedin.com/in/YOUR-LINKEDIN-USERNAME" target="_blank">
                    LinkedIn Profile
                </a>
            </p>
        </section>

    </main>

    <footer>
        <p>© 2026 Key. All Rights Reserved.</p>
    </footer>



